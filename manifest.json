{
  "manifest_version": 2,
  "name": "Comment Out",
  "version": "1.3",
  "description": "Comment out HTML elements on any page by tag, class, id or CSS selector. Built for automation testing.",
  "permissions": [
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Comment Out",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{0ac43cf5-8c84-4ff0-9f24-0016809106cc}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}